DISCORD_TOKEN=
GUILD_ID=
# GLOBAL: mọi server đã mời bot; GUILD: chỉ server GUILD_ID để phát triển nhanh.
SLASH_COMMAND_SCOPE=GLOBAL
DATABASE_URL=postgresql://user:password@localhost:5432/tieudao
NODE_ENV=development
MESSAGE_COMMAND_PREFIX=!

# Development defaults to 5. Required explicitly when NODE_ENV=production.
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000
DB_SLOW_QUERY_MS=250

# Optional stable identifier for the dedicated outbox worker. Defaults to hostname:pid.
OUTBOX_WORKER_ID=

# Required only by the isolated Phase 7 PostgreSQL verification harness.
# Must differ from DATABASE_URL. Never point this at the production database.
PHASE7_TEST_DATABASE_URL=

# Dedicated integration databases. Must differ from DATABASE_URL.
PROGRESSION_TEST_DATABASE_URL=
ACTIVITY_TEST_DATABASE_URL=

# Optional source for `db:import:vi-words`. Falls back to PROGRESSION_TEST_DATABASE_URL.
# Must point to a database different from DATABASE_URL and contain public.words.
WORD_DICTIONARY_SOURCE_DATABASE_URL=
